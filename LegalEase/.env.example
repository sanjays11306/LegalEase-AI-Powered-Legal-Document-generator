# Copy to .env and add your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key

# Primary model. gemini-3.8-flash is generally available (checked against Google's docs, Oct 2026).
# If it fails, gemini-3.7-flash and gemini-3.6-flash are tried automatically.
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.1-pro-preview
# Reasoning effort: low (fastest) | medium (default) | high (most careful, slower)
GEMINI_THINKING_LEVEL=medium

# ---------------- Before you deploy (see README > Security & cost) ----------------
# Refuse anonymous use. Create logins with:   python auth.py hash-password
LEGALEASE_REQUIRE_LOGIN=0
# LEGALEASE_USERS=alice=scrypt$...,bob=scrypt$...
# API keys for POST /api/*. Create with:      python auth.py new-api-key alice
# LEGALEASE_API_KEYS=<key>=alice

# Cost limits (defaults shown). The global cap is your spending ceiling.
# LEGALEASE_BURST_LIMIT=5            # per user per minute
# LEGALEASE_DAILY_LIMIT=20           # AI-drafted documents per user per day
# LEGALEASE_DAILY_REVIEW_LIMIT=40    # AI reviews per user per day
# LEGALEASE_GLOBAL_DAILY_LIMIT=500   # all users together, per day
# LEGALEASE_GLOBAL_REVIEW_LIMIT=1000

# Where saved drafts live (default: data/legalease.db)
# LEGALEASE_DB=data/legalease.db

# Optional: make the web UI call the FastAPI server instead of generating inside Streamlit
# LEGALEASE_API_URL=http://127.0.0.1:8000/api/generate
# LEGALEASE_API_KEY=<one of the keys above>
